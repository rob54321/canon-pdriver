#!/bin/bash
# install.sh runs apt so it cannot be called directly from postinst
cd /home/robert/canon-drv
# exract the .gz file
#tar -xvzf linux-UFRII-drv-v620-m17n-20.tar.gz

# check if X is running,
if [ -n "$DISPLAY" ]; then
	# X is running install
	# install thunderbird after time delay
	# so lock is released first
	echo "============================================================="
	echo "Installing canon drivers in 2 seconds"
	echo "============================================================="
	(sleep 2; /home/robert/canon-drv/install.sh > canon-drv-output.txt 2>&1) &

	# message to show posinst has finished
	echo "============================================================="
	echo "canon-pdriver:postinst has finished"
	echo "============================================================="

else
	# X is not running cannot install
	echo "X is not running, read the following unstructions for installing:"
	echo "Start X "
	echo "then run /home/robert/canon-drv/install.sh in a terminal as root"
fi
exit 0;
